{
  "name": "platform-ensu",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "trustedDependencies": [
    "esbuild",
    "lightningcss"
  ],
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "check": "prettier --check .",
    "db:up": "docker compose up -d",
    "db:generate": "bun --filter @encounter/db db:generate",
    "db:migrate": "bun --filter @encounter/db db:migrate",
    "db:push": "bun --filter @encounter/db db:push",
    "db:pull": "bun --filter @encounter/db db:pull",
    "db:studio": "bun --filter @encounter/db db:studio"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "turbo": "latest",
    "typescript": "^6.0.2"
  }
}
