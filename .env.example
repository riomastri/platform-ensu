# ==========================================
# Database Neon PostgreSQL (Gunakan Branch "dev" untuk Lokal!)
# ==========================================
# 1) DATABASE_URL: Wajib memakai POOLED connection string (ada "-pooler" pada hostname) + ?sslmode=require
# 2) DIRECT_DATABASE_URL: Wajib memakai DIRECT/UNPOOLED connection string (TANPA "-pooler") untuk migrasi drizzle-kit
# Opsional offline Docker lokal (docker-compose.yml): postgresql://ensu:ensu_local_dev_password@localhost:5432/encounter_sumatra
DATABASE_URL="postgresql://neondb_owner:replace_password@ep-replace-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_DATABASE_URL="postgresql://neondb_owner:replace_password@ep-replace.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ==========================================
# Rate Limiting (Upstash Redis REST — Wajib untuk /api/chat)
# ==========================================
# Salin dari Upstash Console -> Database -> REST API
UPSTASH_REDIS_REST_URL="https://replace-with-your-endpoint.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-with-your-upstash-rest-token"
# Opsional / legacy Docker Valkey lokal (tidak dipakai oleh rate limiter REST Upstash):
VALKEY_URL="redis://localhost:6379"

# ==========================================
# Application Metadata (Server-only)
# ==========================================
APP_URL="http://localhost:3000"
APP_TITLE="Platform Encounter Sumatra"

# ==========================================
# Better Auth (Autentikasi & Sesi)
# ==========================================
# Wajib minimal 32 byte (64 karakter hex). Buat nilai acak unik via terminal:
#   openssl rand -hex 32
# atau di Windows PowerShell tanpa OpenSSL:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-64-char-hex-secret-32-bytes-minimum-do-not-reuse"

# ==========================================
# AI Concierge (TanStack AI + OpenRouter)
# ==========================================
# Nilai AI_MODE: "free_dev" (model :free untuk dev) | "production" (model berbayar + ZDR strict)
AI_MODE="free_dev"
OPENROUTER_API_KEY="sk-or-v1-replace-with-your-openrouter-api-key"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"

# ==========================================
# Keamanan Data & Afiliasi (UU PDP)
# ==========================================
# Masing-masing WAJIB berupa secret 32-byte hex (64 karakter) yang BERBEDA satu sama lain.
# Jalankan perintah generator sekali lagi untuk setiap key di bawah ini.
ENCRYPTION_KEY="replace-with-unique-64-char-hex-key-32-bytes-for-aes-256"
AFFILIATE_HASH_SALT="replace-with-unique-64-char-hex-salt-32-bytes-for-hashing"