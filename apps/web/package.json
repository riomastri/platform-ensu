{
  "name": "@encounter/web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun --bun vite dev --port 3000",
    "generate-routes": "bun --bun vite build",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "start": "node --env-file-if-exists=../../.env.local --env-file-if-exists=../../.env .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@encounter/api": "workspace:*",
    "@encounter/db": "workspace:*",
    "@encounter/design-tokens": "workspace:*",
    "@encounter/shared": "workspace:*",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@inlang/paraglide-js": "^3.2.2",
    "@orpc/client": "^1.16.6",
    "@orpc/openapi": "^1.16.6",
    "@orpc/tanstack-query": "^1.16.6",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/ai": "^1.8.0",
    "@tanstack/ai-openrouter": "^1.1.2",
    "@tanstack/ai-react": "^1.1.1",
    "@tanstack/react-devtools": "0.10.15",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.4",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "1.169.7",
    "@unpic/react": "^1.0.2",
    "better-auth": "^1.7.28",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.83.0",
    "nitro": "3.0.261103-rc",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.23.1",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "0.8.7",
    "@tanstack/eslint-config": "0.5.0",
    "@tanstack/intent": "^0.5.6",
    "@types/node": "^26.6.11",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.20.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.1.2"
  },
  "intent": {
    "skills": [
      "@tanstack/ai",
      "@tanstack/devtools",
      "@tanstack/devtools-event-client",
      "@tanstack/devtools-vite",
      "@tanstack/markdown",
      "@tanstack/react-router",
      "@tanstack/react-start",
      "@tanstack/router-core",
      "@tanstack/router-plugin",
      "@tanstack/start-client-core",
      "@tanstack/start-server-core",
      "@tanstack/virtual-file-routes"
    ]
  }
}
